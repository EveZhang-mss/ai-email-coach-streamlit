# AI provider: deepseek (default) or openai
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# SQLite file is created automatically if it does not exist.
DATABASE_URL=sqlite:///./ai_email_coach.db
# Automatically create sample learners on an empty database (true/false)
SEED_DEMO_DATA=true
PASS_THRESHOLD=80
REMINDER_AFTER_DAYS=3

# QQ mailbox app password (not your normal mailbox password)
EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_AUTH_CODE=
IMAP_HOST=imap.qq.com
IMAP_PORT=993
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
